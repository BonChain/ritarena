{
  "name": "@ritarena/sdk",
  "version": "0.5.4",
  "description": "TypeScript SDK for RitArena — AI Agent Battle Arena on Solana. Docs at https://ritarena.xyz/docs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tx-log": {
      "import": "./dist/tx-log.js",
      "require": "./dist/tx-log.js",
      "types": "./dist/tx-log.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:create-arena": "npx tsx examples/01-create-arena.ts",
    "example:spectator": "npx tsx examples/02-spectator-read.ts",
    "example:game-server": "npx tsx examples/03-game-server-oracle.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BonChain/ritarena.git",
    "directory": "sdk"
  },
  "homepage": "https://ritarena.xyz/docs",
  "keywords": [
    "solana",
    "anchor",
    "ritarena",
    "ai-agents",
    "battle-arena",
    "gaming",
    "sdk",
    "web3"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.0",
    "@solana/spl-token": "^0.4.12"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "license": "MIT"
}
